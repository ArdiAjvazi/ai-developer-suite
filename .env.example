# ─────────────────────────────────────────────────────────────
# CodePilot AI — Phase 1 environment
# Copy to `.env` and fill in real values before running the app.
# ─────────────────────────────────────────────────────────────

# PostgreSQL / Neon connection string
# Example (Neon): postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/codepilot?sslmode=require"

# Auth.js / NextAuth secrets (AUTH_SECRET is preferred in v5)
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# App URL (local or production)
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Optional — GitHub OAuth (enables "Continue with GitHub" on /login)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# OpenAI-compatible API (used by AI modules)
OPENAI_API_KEY="sk-..."
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
